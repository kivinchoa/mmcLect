issn = {0261-3069},
doi = {https://doi.org/10.1016/S0261-3069(89)80027-5},
url = {https://www.sciencedirect.com/science/article/pii/S0261306989800275},
author = {J White and T.C. Willis},
abstract = {The production of metal matrix composite (MMC) systems using the technique of spray co-deposition is described. Mechanical properties of three MMC systems are presented: 2618 + SiC, 7075 + SiC and 8090 + SiC. These properties are compared with those of the respective unreinforced alloys and the advantages of spray deposition as a method of producing MMC materials is discussed.}
